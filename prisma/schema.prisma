// Street Wrenchers — PostgreSQL schema
// All timestamps are stored in UTC; the app renders them in Asia/Dubai.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum LeadType {
  SERVICE_BOOKING
  CONTACT
  AMC
  WHATSAPP
  RENTAL
  CAR_SALES
  BUY_CAR
  SELL_CAR
  MARKETING
}

enum ModuleStatus {
  ACTIVE
  COMING_SOON
  HIDDEN
  DRAFT
}

enum ModuleKey {
  CAR_RENTAL
  CAR_SALES
  BUY_A_CAR
  SELL_YOUR_CAR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum VehicleCondition {
  NEW
  USED
}

enum RentalAvailability {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum AnalyticsType {
  PAGE_VIEW
  WHATSAPP_CLICK
  BOOKING_START
  BOOKING_SUBMIT
  LEAD_SUBMIT
  CAMPAIGN_CONVERSION
}

// ─────────────────────────── Access ───────────────────────────

model Owner {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("OWNER")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  ownerId   String
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
  @@index([expiresAt])
}

// ─────────────────────────── Catalogue ───────────────────────────

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
}

model Service {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  categoryId       String
  category         ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shortDescription String
  description      String           @db.Text
  price            Decimal?         @db.Decimal(12, 2)
  priceNote        String?
  duration         String?
  image            String?
  gallery          String[]         @default([])
  inclusions       String[]         @default([])
  benefits         String[]         @default([])
  isFeatured       Boolean          @default(false)
  isPublished      Boolean          @default(true)
  sortOrder        Int              @default(0)
  metaTitle        String?
  metaDescription  String?
  keywords         String[]         @default([])
  ogImage          String?
  schema           Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  packages         ServicePackage[]
  bookings         Booking[]
  faqs             Faq[]

  @@index([categoryId])
  @@index([isPublished, isFeatured])
}

model ServicePackage {
  id           String    @id @default(cuid())
  serviceId    String?
  service      Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name         String
  slug         String    @unique
  tier         String    @default("CUSTOM")
  description  String?
  price        Decimal   @db.Decimal(12, 2)
  priceNote    String?
  duration     String?
  labourCharge Decimal?  @db.Decimal(12, 2)
  warranty     String?
  inclusions   String[]  @default([])
  exclusions   String[]  @default([])
  isFeatured   Boolean   @default(false)
  isPublished  Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]

  @@index([serviceId])
}

model AmcPlan {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  tagline         String?
  description     String         @db.Text
  price           Decimal        @db.Decimal(12, 2)
  priceNote       String?
  billingPeriod   String         @default("YEAR")
  durationMonths  Int            @default(12)
  kmLimit         Int?
  inclusions      String[]       @default([])
  exclusions      String[]       @default([])
  benefits        String[]       @default([])
  isFeatured      Boolean        @default(false)
  isPublished     Boolean        @default(true)
  sortOrder       Int            @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  brands          Brand[]        @relation("AmcPlanBrands")
  models          VehicleModel[] @relation("AmcPlanModels")
  leads           Lead[]
}

model Brand {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  logo         String?
  country      String?
  isFeatured   Boolean        @default(false)
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  models       VehicleModel[]
  amcPlans     AmcPlan[]      @relation("AmcPlanBrands")
  saleVehicles SaleVehicle[]
  bookings     Booking[]      @relation("BookingBrand")
}

model VehicleModel {
  id        String    @id @default(cuid())
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  yearFrom  Int?
  yearTo    Int?
  fuelTypes String[]  @default([])
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[] @relation("BookingModel")
  amcPlans  AmcPlan[] @relation("AmcPlanModels")

  @@unique([brandId, slug])
  @@index([brandId])
}

// ─────────────────────────── Customers & bookings ───────────────────────────

model Customer {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  email         String?
  notes         String?   @db.Text
  totalBookings Int       @default(0)
  totalSpent    Decimal   @default(0) @db.Decimal(12, 2)
  lastVisitAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  leads         Lead[]
}

model Booking {
  id             String          @id @default(cuid())
  reference      String          @unique
  status         BookingStatus   @default(PENDING)
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  phone          String
  email          String?
  brandId        String?
  brand          Brand?          @relation("BookingBrand", fields: [brandId], references: [id], onDelete: SetNull)
  vehicleModelId String?
  vehicleModel   VehicleModel?   @relation("BookingModel", fields: [vehicleModelId], references: [id], onDelete: SetNull)
  brandName      String?
  modelName      String?
  year           Int?
  fuelType       String?
  serviceId      String?
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  packageId      String?
  package        ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  serviceName    String
  packageName    String?
  preferredDate  DateTime
  preferredTime  String
  pickupRequired Boolean         @default(false)
  pickupAddress  String?
  notes          String?         @db.Text
  adminNotes     String?         @db.Text
  priceEstimate  Decimal?        @db.Decimal(12, 2)
  source         String?
  utm            Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lead           Lead?

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([preferredDate])
}

// ─────────────────────────── CRM ───────────────────────────

model Lead {
  id           String         @id @default(cuid())
  name         String
  phone        String
  email        String?
  type         LeadType       @default(CONTACT)
  status       LeadStatus     @default(NEW)
  vehicleBrand String?
  vehicleModel String?
  vehicleYear  Int?
  message      String?        @db.Text
  source       String         @default("website")
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  campaignId   String?
  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  landingPage  String?
  notes        String?        @db.Text
  followUpAt   DateTime?
  customerId   String?
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookingId    String?        @unique
  booking      Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  amcPlanId    String?
  amcPlan      AmcPlan?       @relation(fields: [amcPlanId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  activities   LeadActivity[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([campaignId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  note      String   @db.Text
  ownerId   String?
  createdAt DateTime @default(now())

  @@index([leadId])
}

// ─────────────────────────── CMS ───────────────────────────

model Page {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  template        String        @default("default")
  status          PublishStatus @default(PUBLISHED)
  isSystem        Boolean       @default(false)
  metaTitle       String?
  metaDescription String?
  keywords        String[]      @default([])
  canonical       String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  robots          String        @default("index,follow")
  schema          Json?
  publishedAt     DateTime?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sections        PageSection[]
  faqs            Faq[]

  @@index([status])
}

model PageSection {
  id             String   @id @default(cuid())
  pageId         String
  page           Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key            String
  type           String
  eyebrow        String?
  heading        String?
  subheading     String?
  body           String?  @db.Text
  image          String?
  imageAlt       String?
  ctaLabel       String?
  ctaHref        String?
  secondaryLabel String?
  secondaryHref  String?
  data           Json?
  sortOrder      Int      @default(0)
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, sortOrder])
}

model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  mobileImage String?
  ctaLabel    String?
  ctaHref     String?
  placement   String    @default("home-hero")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([placement, isActive])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  filename  String
  alt       String?
  mimeType  String?
  width     Int?
  height    Int?
  size      Int?
  folder    String   @default("library")
  createdAt DateTime @default(now())

  @@index([folder])
}

model Blog {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String        @db.Text
  content         String        @db.Text
  coverImage      String?
  category        String?
  tags            String[]      @default([])
  author          String        @default("Street Wrenchers")
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  readMinutes     Int?
  views           Int           @default(0)
  metaTitle       String?
  metaDescription String?
  keywords        String[]      @default([])
  ogImage         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  vehicle     String?
  rating      Int      @default(5)
  quote       String   @db.Text
  source      String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  category    String?
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  pageId      String?
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
  @@index([pageId])
}

// ─────────────────────────── Marketing ───────────────────────────

model Campaign {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  source      String
  medium      String
  campaignId  String?
  landingPage String?
  startDate   DateTime?
  endDate     DateTime?
  status      CampaignStatus   @default(DRAFT)
  notes       String?          @db.Text
  utmTerm     String?
  utmContent  String?
  conversions Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  leads       Lead[]
  events      MarketingEvent[]
}

model MarketingEvent {
  id         String    @id @default(cuid())
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  type       String
  path       String?
  referrer   String?
  sessionId  String?
  value      Decimal?  @db.Decimal(12, 2)
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([campaignId])
  @@index([type, createdAt])
}

model AnalyticsEvent {
  id         String        @id @default(cuid())
  type       AnalyticsType
  path       String
  sessionId  String?
  campaignId String?
  source     String?
  medium     String?
  value      Decimal?      @db.Decimal(12, 2)
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@index([type, createdAt])
  @@index([path])
}

// ─────────────────────────── Future modules ───────────────────────────

model RentalVehicle {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  brand           String
  model           String
  year            Int
  category        String
  transmission    String
  fuelType        String
  seats           Int
  dailyRate       Decimal            @db.Decimal(12, 2)
  weeklyRate      Decimal?           @db.Decimal(12, 2)
  monthlyRate     Decimal?           @db.Decimal(12, 2)
  deposit         Decimal?           @db.Decimal(12, 2)
  description     String             @db.Text
  image           String?
  gallery         String[]           @default([])
  features        String[]           @default([])
  availability    RentalAvailability @default(AVAILABLE)
  isPublished     Boolean            @default(false)
  sortOrder       Int                @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model SaleVehicle {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  brandId         String?
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandName       String
  model           String
  year            Int
  mileage         Int?
  condition       VehicleCondition @default(USED)
  price           Decimal          @db.Decimal(12, 2)
  negotiable      Boolean          @default(true)
  transmission    String?
  fuelType        String?
  bodyType        String?
  color           String?
  description     String           @db.Text
  image           String?
  gallery         String[]         @default([])
  features        String[]         @default([])
  isPublished     Boolean          @default(false)
  isSold          Boolean          @default(false)
  sortOrder       Int              @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isPublished, isSold])
}

// ─────────────────────────── System ───────────────────────────

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}
