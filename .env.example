/**
 * Street Wrenchers — environment template.
 * Copy to .env for local development (read by both Next.js and the Prisma CLI)
 * and configure the same keys on Vercel for production.
 * Never commit real credentials.
 */

# ── PostgreSQL (Neon, Supabase, RDS, or any PostgreSQL 14+) ──────────────────
# Production: set the pooled connection string. Add ?sslmode=require when required by the provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/street_wrenchers?schema=public&sslmode=require"

# Optional: direct (non-pooled) connection. Recommended when DATABASE_URL is pooled;
# `prisma migrate deploy` and the seed use DIRECT_URL first and fall back to DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/street_wrenchers?sslmode=require"

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://www.streetwrenchers.ae"
NODE_ENV="production"

# ── Production database bootstrap (Vercel builds) ────────────────────────────
# `vercel-build` applies pending migrations and runs the idempotent seed on production
# deployments. The seed only creates missing records and never deletes data.
# SEED_ON_DEPLOY="true"
# Emergency override: skip migrations and seed for a single deployment.
# SKIP_DB_MIGRATIONS="false"

# ── Single owner account (created by the idempotent seed script) ─────────────
OWNER_NAME="Street Wrenchers Owner"
OWNER_EMAIL="owner@streetwrenchers.ae"
# Use a unique, strong password (16+ characters). Stored only as a scrypt hash.
OWNER_PASSWORD="<set-a-strong-unique-password>"
# Set to "true" only when you intend to overwrite the existing owner password.
OWNER_RESET_PASSWORD="false"

# ── Media storage (Cloudinary) ───────────────────────────────────────────────
# Uploads are disabled until these are set. Static brand assets ship in /public.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="street-wrenchers"

# ── Marketing integrations (optional, editable in dashboard → Marketing) ─────
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
