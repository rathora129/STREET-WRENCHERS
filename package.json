{
  "name": "street-wrenchers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Street Wrenchers — premium automotive service website, booking platform and management dashboard for Dubai, UAE.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "node --test tests/*.test.mjs",
    "vercel-build": "node scripts/deploy-db.mjs && prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "db:bootstrap": "node scripts/deploy-db.mjs",
    "db:setup": "prisma migrate deploy && node prisma/seed.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.107.1",
    "cloudinary": "2.7.0",
    "formik": "2.4.9",
    "framer-motion": "14.12.0",
    "lucide-react": "1.71.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "6.6.0",
    "yup": "1.7.1",
    "zod": "4.1.12",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "sharp": "0.35.5"
  }
}
